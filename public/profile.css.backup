* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f5f6fa;
    color: #111;
}

header {
    height: 60px;
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 0 18px;
    background: white;
    border-bottom: 1px solid #ddd;
}

header button {
    border: 0;
    background: transparent;
    font-size: 28px;
    cursor: pointer;
}

header h2 {
    margin: 0;
}

main {
    max-width: 700px;
    margin: auto;
    padding: 20px 15px 50px;
}

.profile-card {
    background: white;
    border-radius: 18px;
    padding: 25px 15px;
    text-align: center;
    box-shadow: 0 4px 18px rgba(0,0,0,0.08);
}

.avatar {
    width: 85px;
    height: 85px;
    margin: auto;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #111;
    color: white;
    font-size: 38px;
    font-weight: bold;
}

.profile-card h1 {
    margin: 12px 0 4px;
}

.profile-card p {
    margin: 0;
    color: #777;
}

.stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-top: 25px;
}

.stats div {
    padding: 10px 3px;
}

.stats strong {
    display: block;
    font-size: 20px;
}

.stats span {
    display: block;
    margin-top: 4px;
    font-size: 12px;
    color: #777;
}

.videos-section {
    margin-top: 25px;
}

.videos-section h2 {
    margin-bottom: 15px;
}

.video-card {
    background: white;
    padding: 12px;
    margin-bottom: 18px;
    border-radius: 15px;
    box-shadow: 0 3px 12px rgba(0,0,0,0.07);
}

.video-card video {
    width: 100%;
    max-height: 400px;
    border-radius: 12px;
    display: block;
    background: #000;
}

.video-card h3 {
    margin: 12px 0 5px;
}

.video-card p {
    color: #666;
    margin: 0 0 8px;
}

.video-card small {
    color: #777;
}

@media (max-width: 500px) {

    .stats {
        grid-template-columns: repeat(2, 1fr);
    }

}

.subscribe-btn {
    margin-top: 15px;
    border: 0;
    border-radius: 22px;
    padding: 10px 28px;
    background: #111;
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
}

.subscribe-btn:hover {
    opacity: 0.9;
}

.subscribe-btn:disabled {
    cursor: not-allowed;
    opacity: 0.6;
}
