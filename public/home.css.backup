* {
    box-sizing: border-box;
}

body {
    margin: 0;
    padding-bottom: 75px;
    font-family: Arial, sans-serif;
    background: #f7f7f7;
    color: #161616;
}

.topbar {
    position: sticky;
    top: 0;
    z-index: 10;
    height: 64px;
    background: white;
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 0 18px;
    border-bottom: 1px solid #eee;
}

.brand {
    font-size: 25px;
    font-weight: 900;
    letter-spacing: 2px;
    color: #f4511e;
}

.search {
    flex: 1;
    max-width: 600px;
    display: flex;
    margin: auto;
}

.search input {
    width: 100%;
    height: 42px;
    border: 1px solid #ddd;
    border-radius: 22px 0 0 22px;
    padding: 0 18px;
    font-size: 15px;
    outline: none;
}

.search button {
    width: 55px;
    border: 1px solid #ddd;
    border-left: 0;
    border-radius: 0 22px 22px 0;
    background: #f5f5f5;
}

.top-actions {
    display: flex;
    gap: 8px;
}

.top-actions button {
    border: 0;
    background: none;
    font-size: 20px;
}

.categories {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding: 13px 18px;
    background: white;
    scrollbar-width: none;
}

.categories button {
    border: 0;
    padding: 9px 16px;
    border-radius: 20px;
    background: #eee;
    white-space: nowrap;
}

.categories .active {
    background: #f4511e;
    color: white;
}

main {
    max-width: 1100px;
    margin: auto;
    padding: 18px;
}

.welcome {
    padding: 25px;
    border-radius: 20px;
    background: linear-gradient(135deg, #fff1e8, #ffffff);
    margin-bottom: 28px;
}

.welcome h1 {
    margin: 0 0 7px;
}

.welcome p {
    margin: 0;
    color: #666;
}

.section-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 22px 0 14px;
}

.section-title h2 {
    font-size: 21px;
    margin: 0;
}

.section-title span {
    color: #f4511e;
    font-size: 14px;
}

.videos {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
}

.video {
    background: white;
    border-radius: 16px;
    overflow: hidden;
}

.thumbnail {
    height: 190px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #ddd;
    font-size: 55px;
}

.video-info {
    display: flex;
    gap: 12px;
    padding: 13px;
}

.avatar,
.creator-avatar {
    flex-shrink: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 50%;
    background: #f4511e;
    color: white;
    font-weight: bold;
}

.avatar {
    width: 40px;
    height: 40px;
}

.video h3 {
    margin: 0 0 5px;
    font-size: 16px;
}

.video p,
.video small {
    color: #666;
    margin: 0;
}

.creators {
    display: flex;
    gap: 14px;
    overflow-x: auto;
}

.creator {
    min-width: 180px;
    background: white;
    border-radius: 18px;
    padding: 20px;
    text-align: center;
}

.creator-avatar {
    width: 65px;
    height: 65px;
    margin: auto;
    font-size: 25px;
}

.creator h3 {
    margin: 10px 0 5px;
}

.creator p {
    color: #666;
    font-size: 13px;
}

.creator button {
    border: 0;
    border-radius: 20px;
    padding: 9px 14px;
    background: #f4511e;
    color: white;
}

.bottom-nav {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 68px;
    background: white;
    border-top: 1px solid #ddd;
    display: flex;
    justify-content: space-around;
    z-index: 20;
}

.bottom-nav button {
    border: 0;
    background: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    color: #555;
}

.bottom-nav strong {
    font-size: 21px;
}

.bottom-nav span {
    font-size: 11px;
}

.bottom-nav .selected {
    color: #f4511e;
}

.create strong {
    font-size: 28px;
}

@media (max-width: 600px) {

    .topbar {
        padding: 0 12px;
        gap: 10px;
    }

    .brand {
        font-size: 20px;
    }

    .search {
        max-width: none;
    }

    .top-actions {
        display: none;
    }

    .videos {
        grid-template-columns: 1fr;
    }

    .thumbnail {
        height: 210px;
    }

    main {
        padding: 12px;
    }
}

.dynamic-video {
    overflow: hidden;
}

.video-player {
    width: 100%;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: #000;
    border-radius: 14px;
}

.empty-feed {
    padding: 40px 20px;
    text-align: center;
    border-radius: 14px;
    background: #f5f5f5;
}

.empty-feed h3 {
    margin-bottom: 8px;
}

.empty-feed p {
    margin: 0;
    opacity: 0.7;
}

@media (max-width: 600px) {
    .video-player {
        border-radius: 10px;
    }
}

.dynamic-video {
    overflow: hidden;
}

.video-player {
    width: 100%;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: #000;
    border-radius: 14px;
}

.empty-feed {
    padding: 40px 20px;
    text-align: center;
    border-radius: 14px;
    background: #f5f5f5;
}

.empty-feed h3 {
    margin-bottom: 8px;
}

.empty-feed p {
    margin: 0;
    opacity: 0.7;
}

@media (max-width: 600px) {
    .video-player {
        border-radius: 10px;
    }
}

.video-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 10px;
}

.like-btn,
.comment-count {
    border: 0;
    background: transparent;
    font-size: 15px;
}

.like-btn {
    cursor: pointer;
    padding: 5px 8px;
}

.comments-box {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid #ddd;
}

.comments-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 10px;
}

.comment {
    display: flex;
    gap: 8px;
    font-size: 14px;
}

.comment-form {
    display: flex;
    gap: 8px;
}

.comment-input {
    flex: 1;
    min-width: 0;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 20px;
    outline: none;
}

.comment-btn {
    border: 0;
    border-radius: 20px;
    padding: 0 16px;
    cursor: pointer;
}

.creator-avatar {
    cursor: pointer;
}

.creator-name {
    display: inline-block;
    margin-bottom: 5px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
}

.creator-name:hover {
    text-decoration: underline;
}
